{
  "manifest_version": 3,
  "name": "snapvf",
  "version": "0",
  "message_serialization": "structured_clone",
  "description": "Snap video frame",
  "icons": {
    "128": "128.png"
  },
  "commands": {
    "0": {
      "suggested_key": {
        "default": "Ctrl+Shift+V"
      },
      "description": "Snap a video frame"
    }
  },
  "permissions": [
    "contextMenus",
    "debugger",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {}
}
